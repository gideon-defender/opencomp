{
  "name": "comp",
  "version": "1.50.0",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/d3": "^7.4.3",
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "date-fns": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react-dnd": "^16.0.1",
    "react-hook-form": "^7.88.0",
    "semantic-release": "^25.0.7",
    "sharp": "^0.35.4",
    "syncpack": "^13.0.4",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@10.15.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "check:env": "node scripts/check-unused-env.js",
    "check:prisma-schemas": "node scripts/check-generated-prisma-schemas.js",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "deps:check": "syncpack list-mismatches",
    "deps:dedupe": "syncpack fix-mismatches && pnpm install",
    "deps:fix": "syncpack fix-mismatches",
    "deps:lint": "syncpack lint",
    "deps:update": "syncpack update",
    "deps:upgrade": "syncpack update && pnpm install",
    "dev": "turbo dev --parallel",
    "db:generate": "turbo run db:generate --filter=@gideon-defender/db --filter=@gideon-defender/app --filter=@gideon-defender/portal --filter=@gideon-defender/api --filter=@gideon-defender/framework-editor",
    "docker:clean": "pnpm --filter @gideon-defender/db docker:clean",
    "docker:down": "pnpm --filter @gideon-defender/db docker:down",
    "docker:up": "pnpm --filter @gideon-defender/db docker:up",
    "format": "prettier --write .",
    "lint": "turbo lint && syncpack lint",
    "prepare": "husky",
    "test": "turbo test --parallel",
    "typecheck": "turbo typecheck",
    "typecheck:ci": "turbo typecheck --filter={apps/**} --filter={packages/**} --filter=!@gideon-defender/integrations --filter=!@gideon-defender/ui"
  },
  "workspaces": [
    "apps/*",
    "apps/browser-extension/*",
    "!apps/mcp-server",
    "packages/*"
  ],
  "dependencies": {
    "@trycompai/design-system": "*",
    "@types/react-syntax-highlighter": "^15.5.13",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "overrides": {
      "nwsapi": "2.2.16",
      "axios": "^1.16.0",
      "vitest": "^4.1.11",
      "@vitest/coverage-v8": "^4.1.11",
      "@vitest/ui": "^4.1.11",
      "js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
      "form-data": "^4.0.6",
      "ws": "^8.21.0",
      "engine.io": "^6.6.7",
      "tar": "^7.5.22",
      "semver": "^7.8.5",
      "hono": "^4.12.25",
      "@hono/node-server": "^1.19.13",
      "multer": "^2.2.0",
      "systeminformation": "^5.31.17",
      "tmp": "^0.2.7",
      "dompurify": "^3.4.12",
      "ip-address": "^10.3.1",
      "postcss": "^8.5.11",
      "prismjs": "^1.30.0",
      "qs": "^6.15.3",
      "effect": "^3.20.0",
      "protobufjs": "^7.6.3",
      "linkify-it": "^5.0.1",
      "mermaid": "^11.15.0",
      "shell-quote": "^1.8.4",
      "vite": "^6.4.3",
      "@opentelemetry/core": "^2.8.0",
      "@sigstore/core": "3.2.1",
      "markdown-it": "^14.3.0",
      "@babel/core": "^7.29.7",
      "uuid": "^11.1.1",
      "@tiptap/core": "3.31.3",
      "@tiptap/extension-blockquote": "3.31.3",
      "@tiptap/extension-bold": "3.31.3",
