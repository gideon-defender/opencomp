      "@tiptap/extension-typography": "3.31.3",
      "@tiptap/extension-underline": "3.31.3",
      "@tiptap/extensions": "3.31.3",
      "@tiptap/pm": "3.31.3",
      "@tiptap/react": "3.31.3",
      "@tiptap/starter-kit": "3.31.3",
      "@tiptap/suggestion": "3.31.3",
      "undici": "^6.28.0 || ^7.29.0",
      "deepmerge-ts": "^8.0.2",
      "adm-zip": "^0.6.0",
      "@puppeteer/browsers": "^3.2.1",
      "syncpack>minimatch": "^9.0.7",
      "tiptap-extension-global-drag-handle": "^0.1.18",
      "@radix-ui/react-dialog": "1.1.23",
      "@radix-ui/react-popover": "1.1.23",
      "@radix-ui/react-dismissable-layer": "1.1.19",
      "@radix-ui/react-focus-scope": "1.1.16",
      "@semantic-release/npm": "^13.1.5",
      "esbuild": "<0.27.3 || >=0.28.2",
      "mysql2": "^3.24.3",
      "builder-util-runtime": "^9.7.0",
      "app-builder-lib": "^26.16.1",
      "electron-builder-squirrel-windows": "^26.16.1"
    }
  }
}
