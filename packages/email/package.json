{
  "name": "@gideon-defender/email",
  "description": "Email templates and utilities for OpenComp",
  "version": "1.0.0",
  "dependencies": {
    "@react-email/components": "^0.0.41",
    "@react-email/render": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./emails/*": "./emails/*",
    "./lib/*": "./lib/*"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "keywords": [
    "opencomp",
    "email-templates",
    "react-email"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comp-ai/comp.git",
    "directory": "packages/email"
  },
  "scripts": {
    "build": "tsup index.ts --format cjs,esm --dts",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "tsup index.ts --format cjs,esm --watch --dts",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "types": "./dist/index.d.ts"
}
