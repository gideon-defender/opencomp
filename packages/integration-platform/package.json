{
  "name": "@gideon-defender/integration-platform",
  "version": "1.0.0",
  "dependencies": {
    "@aws-sdk/client-cloudtrail": "3.1013.0",
    "@aws-sdk/client-ec2": "^3.948.0",
    "@aws-sdk/client-iam": "^3.948.0",
    "@aws-sdk/client-kms": "^3.948.0",
    "@aws-sdk/client-rds": "^3.948.0",
    "@aws-sdk/client-s3": "3.1013.0",
    "@aws-sdk/client-s3-control": "^3.943.0",
    "@aws-sdk/client-securityhub": "^3.948.0",
    "@aws-sdk/client-sts": "^3.948.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "import": "./dist/registry/index.js",
      "require": "./dist/registry/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js"
    }
  },
  "main": "./dist/index.js",
  "peerDependencies": {
    "react": "^19.2.3"
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "generate:tasks": "tsx scripts/generate-task-types.ts",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/validators/manifest-validator.ts"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts"
}
