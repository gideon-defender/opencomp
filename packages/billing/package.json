{
  "name": "@gideon-defender/billing",
  "version": "1.0.0",
  "devDependencies": {
    "@gideon-defender/tsconfig": "*",
    "@types/node": "^24.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "private": true,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts"
}
