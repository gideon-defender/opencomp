{
  "name": "@gideon-defender/utils",
  "version": "1.0.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1013.0",
    "@aws-sdk/s3-request-presigner": "3.1013.0",
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vendor-logo": {
      "types": "./dist/vendor-logo.d.ts",
      "default": "./dist/vendor-logo.js"
    },
    "./devices": {
      "types": "./dist/devices.d.ts",
      "default": "./dist/devices.js"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "default": "./dist/encryption.js"
    },
    "./envs": {
      "types": "./dist/envs.d.ts",
      "default": "./dist/envs.js"
    },
    "./file": {
      "types": "./dist/file.d.ts",
      "default": "./dist/file.js"
    },
    "./fleet": {
      "types": "./dist/fleet.d.ts",
      "default": "./dist/fleet.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "default": "./dist/s3.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false
}
