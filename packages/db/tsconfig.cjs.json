{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": false,
    "declarationMap": false,
    "outDir": "./dist/cjs",
    "verbatimModuleSyntax": false
  },
  "exclude": ["node_modules", "dist", "src/generated", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
