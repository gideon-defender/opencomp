{
  "name": "@gideon-defender/mcp-server",
  "version": "0.3.0",
  "author": "OpenComp",
  "bin": {
    "@gideon-defender/mcp-server": "bin/mcp-server.js",
    "mcp": "bin/mcp-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@stricli/core": "^1.1.2",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.2.0",
    "@eslint/js": "^9.26.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.0",
    "globals": "^17.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "1.26.0",
      "hono": ">=4.12.34",
      "fast-uri": ">=4.1.2 <5.0.0",
      "js-yaml": ">=4.3.1 <5.0.0",
      "ip-address": ">=10.3.1 <11.0.0",
      "nanoid@^5.0.0": ">=5.1.16 <6.0.0",
      "brace-expansion@^2.0.0": ">=2.1.4 <3.0.0",
      "body-parser": ">=2.3.0 <3.0.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trycompai/comp.git",
    "directory": "apps/mcp-server"
  },
  "scripts": {
    "build": "pnpm install --ignore-workspace && tsx ./src/mcp-server/build.mts && tsc",
    "check": "pnpm run lint",
    "lint": "eslint --cache --max-warnings=0 src",
    "mcpb:build": "pnpm install --ignore-workspace && tsx ./src/mcp-server/build.mts --pack && tsc",
    "prepublishOnly": "pnpm run build"
  },
  "sideEffects": false,
  "type": "module"
}
