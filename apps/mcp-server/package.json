{
  "name": "@gideon-defender/mcp-server",
  "version": "0.2.5",
  "author": "OpenComp",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/gideon-security/opencomp.git",
    "directory": "apps/mcp-server"
  },
  "bin": {
    "@gideon-defender/mcp-server": "bin/mcp-server.js",
    "mcp": "bin/mcp-server.js"
  },
  "scripts": {
    "build": "npm ci && tsx src/mcp-server/build.mts && tsc",
