    "check": "npm run lint",
    "lint": "eslint --cache --max-warnings=0 src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@stricli/core": "^1.1.2",
    "express": "^5.1.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "hono": ">=4.12.25",
    "fast-uri": ">=4.1.3",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^1.2.0",
    "@eslint/js": "^9.26.0",
    "@types/express": "^5.0.1",
    "@types/node": "^24.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.0",
    "globals": "^17.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1"
  }
