{
  "name": "@gideon-defender/portal",
  "version": "0.1.0",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1013.0",
    "@aws-sdk/s3-request-presigner": "3.1013.0",
    "@gideon-defender/analytics": "*",
    "@gideon-defender/auth": "*",
    "@gideon-defender/company": "*",
    "@gideon-defender/email": "*",
    "@gideon-defender/kv": "*",
    "@gideon-defender/ui": "*",
    "@gideon-defender/utils": "*",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "@sentry/nextjs": "^10.51.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.7",
    "@tiptap/react": "^3.31.3",
    "@trycompai/design-system": "*",
    "better-auth": "1.6.26",
    "framer-motion": "^12.23.9",
    "geist": "^1.3.1",
    "lucide-react": "^1.7.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.5",
    "next-safe-action": "^8.0.3",
    "next-themes": "^0.4.4",
    "nuqs": "^2.4.3",
    "posthog-js": "^1.236.6",
    "posthog-node": "^5.29.2",
    "prisma": "7.9.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.7",
    "swr": "^2.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.2.0",
    "eslint": "^10.9.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "build:docker": "prisma generate --schema=prisma/schema && node ../../packages/db/scripts/fix-generated-extensions.js src/generated/prisma && next build",
    "db:generate": "pnpm run db:getschema && prisma generate --schema=prisma/schema && node ../../packages/db/scripts/fix-generated-extensions.js src/generated/prisma",
    "db:getschema": "find prisma/schema -name '*.prisma' ! -name 'schema.prisma' -delete && find ../../packages/db/prisma/schema -name '*.prisma' ! -name 'schema.prisma' -exec cp {} prisma/schema/ \\;",
    "db:migrate": "cd ../../packages/db && pnpm exec prisma migrate dev && cd ../../apps/portal",
    "dev": "next dev --turbopack -p 3002",
    "lint": "eslint . && prettier --check .",
    "prebuild": "pnpm run db:generate",
    "start": "next start",
    "test": "vitest run"
  }
}
