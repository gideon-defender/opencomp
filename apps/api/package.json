    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.5",
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.1",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.2.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.3.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.31.1"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.m?[tj]sx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/|@maced/api-client/|better-auth/|@better-auth/|@noble/|@better-fetch/|jose/|nanostores/|better-call/|zod/|kysely/|rou3/|@standard-schema/|@opentelemetry/)",
      "node_modules/\\.pnpm/[^/]+/node_modules/(?!@maced/api-client/|better-auth/|@better-auth/|@noble/|@better-fetch/|jose/|nanostores/|better-call/|zod/|kysely/|rou3/|@standard-schema/|@opentelemetry/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@db$": "<rootDir>/../prisma/index",
      "^@/(.*)$": "<rootDir>/$1",
      "^\\./sku-definitions\\.js$": "<rootDir>/../../../packages/billing/src/sku-definitions.ts",
      "^@gideon-defender/auth/participation$": "<rootDir>/../../../packages/auth/src/participation.ts",
      "^@gideon-defender/auth$": "<rootDir>/../../../packages/auth/src/index.ts",
      "^@gideon-defender/billing$": "<rootDir>/../../../packages/billing/src/index.ts",
      "^@gideon-defender/company$": "<rootDir>/../../../packages/company/src/index.ts",
      "^@gideon-defender/db$": "@prisma/client",
      "^@gideon-defender/email$": "<rootDir>/../../../packages/email/index.ts",
      "^@gideon-defender/integration-platform$": "<rootDir>/../../../packages/integration-platform/src/index.ts",
      "^@gideon-defender/kv/rate-limit$": "<rootDir>/../../../packages/kv/src/rate-limit.ts",
      "^@gideon-defender/utils$": "<rootDir>/../../../packages/utils/src/index.ts",
      "^@gideon-defender/utils/(.*)$": "<rootDir>/../../../packages/utils/src/$1.ts"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:docker": "pnpm exec prisma generate --schema=prisma/schema && nest build",
    "db:generate": "pnpm run db:getschema && pnpm exec prisma generate --schema=prisma/schema",
    "db:getschema": "find prisma/schema -name '*.prisma' ! -name 'schema.prisma' -delete && find ../../packages/db/prisma/schema -name '*.prisma' ! -name 'schema.prisma' -exec cp {} prisma/schema/ \\;",
    "db:migrate": "cd ../../packages/db && pnpm exec prisma migrate dev && cd ../../apps/api",
    "dev": "nest start --watch",
    "dev:nest": "nest start --watch",
    "dev:no-trigger": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prebuild": "pnpm run db:generate",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --forceExit",
    "test:cov": "jest --coverage --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  }
}
