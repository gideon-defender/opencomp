# =============================================================================
# STAGE 1: Dependencies - Install only what the API needs
# =============================================================================
FROM node:22-slim AS deps

WORKDIR /app

# pnpm binary for this and downstream stages. Fetch flags tolerate flaky
# registry access (dropped TLS mid-download).
RUN npm install -g pnpm@10.15.0 --fetch-retries=8 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

# Copy root workspace config and strip it to only keep what pnpm workspaces
# need (workspaces globs + overrides). The root has frontend deps
# (design-system, react-dnd, sharp, semantic-release, etc.) that the API
# doesn't need. Removing them cuts ~800 packages from the install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN node -e " \
  const fs = require('fs'); \
  const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); \
  delete pkg.dependencies; delete pkg.devDependencies; delete pkg.scripts; \
  fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));"

# Copy only the workspace package.json files the API depends on
COPY packages/auth/package.json ./packages/auth/
COPY packages/db/package.json ./packages/db/
COPY packages/utils/package.json ./packages/utils/
COPY packages/integration-platform/package.json ./packages/integration-platform/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/email/package.json ./packages/email/
COPY packages/company/package.json ./packages/company/
COPY packages/billing/package.json ./packages/billing/
COPY packages/trigger-local/package.json ./packages/trigger-local/
COPY packages/trigger-react-local/package.json ./packages/trigger-react-local/
COPY packages/kv/package.json ./packages/kv/

# Copy API package.json (workspace deps use `*` ranges, which npm links
# locally — no spec conversion needed).
COPY apps/api/package.json ./apps/api/

# Install dependencies — skip lifecycle scripts (husky, prisma postinstall,
# etc. not needed here; prisma is generated explicitly in the builder).
# sharp@^0.34.5 is declared in apps/api/package.json (used by browserbase
# screenshot code); .npmrc carries fetch retries for flaky registries.
RUN pnpm install --ignore-scripts

# =============================================================================
# STAGE 2: Builder - Build workspace packages and NestJS app
# =============================================================================
# Inherit from deps (not a fresh base image) so each workspace package's own
# node_modules symlinks (e.g. packages/db/node_modules/prisma) come along —
# pnpm's strict linking means only copying the top-level node_modules loses
# per-package devDependencies like prisma.
FROM deps AS builder

WORKDIR /app

ENV NODE_OPTIONS=--max_old_space_size=6144

# Copy workspace packages source (node_modules excluded by .dockerignore)
COPY packages/auth ./packages/auth
COPY packages/db ./packages/db
COPY packages/utils ./packages/utils
COPY packages/integration-platform ./packages/integration-platform
COPY packages/tsconfig ./packages/tsconfig
COPY packages/email ./packages/email
COPY packages/company ./packages/company
COPY packages/billing ./packages/billing
COPY packages/trigger-local ./packages/trigger-local
COPY packages/trigger-react-local ./packages/trigger-react-local
COPY packages/kv ./packages/kv

# Copy API source
COPY apps/api ./apps/api

# Build db — generates Prisma client + compiles dist/ for @gideon-defender/db consumers
RUN cd packages/db && pnpm run build

# Build remaining workspace packages
RUN cd packages/auth && pnpm run build \
  && cd ../integration-platform && pnpm run build \
  && cd ../email && pnpm run build \
  && cd ../company && pnpm run build \
  && cd ../billing && pnpm run build \
  && cd ../utils && pnpm run build \
  && cd ../kv && pnpm run build

# Copy model files to api schema dir, then build NestJS app
# Note: @prisma/client is already generated by packages/db build (generate-prisma-client-js.js)
RUN find /app/packages/db/prisma/schema -name '*.prisma' ! -name 'schema.prisma' -exec cp {} /app/apps/api/prisma/schema/ \; \
  && cd /app/apps/api && pnpm exec nest build

# =============================================================================
# STAGE 3: Production Runtime — prod-only install + built artifacts.
# NOTE: `pnpm prune --prod` does NOT strip devDependencies (it only drops
# extraneous packages), so this stage does a fresh `pnpm install --prod`
# instead of copying node_modules from the builder. The builder's full
# install (typescript, @nestjs/cli, jest, ...) never enters this stage.
# =============================================================================
FROM node:22-slim AS production

# Create non-root user before copying files so COPY --chown can use it
RUN groupadd --system nestjs && useradd --system --gid nestjs --create-home nestjs

WORKDIR /app
RUN chown nestjs:nestjs /app

# pnpm for the prod-only install below. Fetch flags tolerate flaky
# registry access (dropped TLS mid-download).
RUN npm install -g pnpm@10.15.0 --fetch-retries=8 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000

# Install runtime dependencies + AWS RDS CA certificate bundle.
# fontconfig + fonts-dejavu-core are needed so sharp/librsvg can render text
# in the browser-automation screenshot overlay (node:*-slim has no fonts).
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget ca-certificates fontconfig fonts-dejavu-core \
  && wget -q -O /usr/local/share/aws-rds-ca-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV NODE_EXTRA_CA_CERTS=/usr/local/share/aws-rds-ca-bundle.pem

# Fresh prod-only install — same manifest set as the deps stage. The root
# package.json is stripped to workspace config only (it carries frontend
# deps the API doesn't need). Sources are NOT copied yet; pnpm only needs
# the manifests to link the workspace.
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY package.json ./
RUN node -e " \
  const fs = require('fs'); \
  const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8')); \
  delete pkg.dependencies; delete pkg.devDependencies; delete pkg.scripts; \
  fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));"
COPY packages/auth/package.json ./packages/auth/
COPY packages/db/package.json ./packages/db/
COPY packages/utils/package.json ./packages/utils/
COPY packages/integration-platform/package.json ./packages/integration-platform/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/email/package.json ./packages/email/
COPY packages/company/package.json ./packages/company/
COPY packages/billing/package.json ./packages/billing/
COPY packages/trigger-local/package.json ./packages/trigger-local/
COPY packages/trigger-react-local/package.json ./packages/trigger-react-local/
COPY packages/kv/package.json ./packages/kv/
COPY apps/api/package.json ./apps/api/
# The content-addressable store (~GBs of tarballs) would otherwise ship in
# this layer — node_modules is hardlinked, so dropping the store is safe.
RUN pnpm install --prod --ignore-scripts && rm -rf "$(pnpm store path)"

# Workspace sources from the build context. .dockerignore keeps this
# node_modules-free (and dist-free); compiled dist/ is copied from the
# builder in the next step.
COPY --chown=nestjs:nestjs packages/auth ./packages/auth
COPY --chown=nestjs:nestjs packages/db ./packages/db
COPY --chown=nestjs:nestjs packages/utils ./packages/utils
COPY --chown=nestjs:nestjs packages/integration-platform ./packages/integration-platform
COPY --chown=nestjs:nestjs packages/tsconfig ./packages/tsconfig
COPY --chown=nestjs:nestjs packages/email ./packages/email
COPY --chown=nestjs:nestjs packages/company ./packages/company
COPY --chown=nestjs:nestjs packages/billing ./packages/billing
COPY --chown=nestjs:nestjs packages/trigger-local ./packages/trigger-local
COPY --chown=nestjs:nestjs packages/kv ./packages/kv

# Compiled output from the builder: NestJS dist, API prisma schema dir, and
# each workspace package's dist/ (their package `exports` point at dist).
COPY --from=builder --chown=nestjs:nestjs /app/apps/api/dist ./dist
COPY --from=builder --chown=nestjs:nestjs /app/apps/api/prisma ./prisma
COPY --from=builder --chown=nestjs:nestjs /app/packages/auth/dist ./packages/auth/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/db/dist ./packages/db/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/integration-platform/dist ./packages/integration-platform/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/email/dist ./packages/email/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/company/dist ./packages/company/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/billing/dist ./packages/billing/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/utils/dist ./packages/utils/dist
COPY --from=builder --chown=nestjs:nestjs /app/packages/kv/dist ./packages/kv/dist

# Generate the Prisma client into the fresh prod node_modules. The prisma
# CLI is a prod dependency of apps/api (not of @gideon-defender/db, where it
# is dev-only), so it lives in apps/api/node_modules — NODE_PATH makes it
# resolvable to the generate script. A copied client would point at the
# builder's store paths, so it must be generated here against this stage's
# install.
RUN cd packages/db && NODE_PATH=/app/apps/api/node_modules node scripts/generate-prisma-client-js.js

# apps/api's own direct dependencies (dotenv, @aws-sdk/client-sqs, etc.) are
# pnpm symlinks living in apps/api/node_modules, not hoisted to the root —
# dist runs from /app/dist rather than /app/apps/api/dist, so add NODE_PATH
# since require() resolution from /app/dist can't see them otherwise.
ENV NODE_PATH=/app/apps/api/node_modules

# ESM-only deps (e.g. openid-client, "type": "module" with no require
# condition) are loaded via dynamic import(), which does NOT respect
# NODE_PATH like require() does — dereference-copy openid-client and its own
# runtime deps (oauth4webapi, jose — pnpm places these as siblings inside
# openid-client's per-package node_modules, not nested inside it) into
# node_modules directly so ESM resolution (which only walks up from
# /app/dist) finds them. Only the three runtime packages are copied (not the
# whole apps/api/node_modules tree) to keep the image minimal.
RUN store_dir="$(dirname "$(readlink -f /app/apps/api/node_modules/openid-client)")" \
  && cp -rL "$store_dir/openid-client" /app/node_modules/openid-client \
  && [ -e /app/node_modules/oauth4webapi ] || cp -rL "$store_dir/oauth4webapi" /app/node_modules/oauth4webapi \
  && [ -e /app/node_modules/jose ] || cp -rL "$store_dir/jose" /app/node_modules/jose \
  && chown -R nestjs:nestjs /app/node_modules/openid-client /app/node_modules/oauth4webapi /app/node_modules/jose

# Resolve the tsconfig `paths` aliases at runtime. Compiled output keeps
# `@/...` and `@db` specifiers; node_modules symlinks make them resolvable.
RUN ln -s /app/dist/src /app/node_modules/@ \
  && ln -s /app/dist/prisma /app/node_modules/@db

# The prod install, Prisma generation, and symlinks above ran as root —
# hand the tree to the runtime user.
RUN chown -R nestjs:nestjs /app/node_modules /app/dist /app/packages /app/prisma /app/apps

# Set production environment
ENV NODE_ENV=production
ENV PORT=3333

USER nestjs

EXPOSE 3333

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3333/v1/health || exit 1

# Start the application with crash diagnostics
CMD ["node", "--report-on-fatalerror", "--report-compact", "dist/src/main.js"]
