BASE_URL=http://localhost:3333
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem
PORT=3333

APP_AWS_BUCKET_NAME=
APP_AWS_QUESTIONNAIRE_UPLOAD_BUCKET=
APP_AWS_KNOWLEDGE_BASE_BUCKET=
APP_AWS_REGION=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_ORG_ASSETS_BUCKET=
APP_AWS_ENDPOINT="" # optional for using services like MinIO

# ── Gideon is the sole authenticator (OIDC) ─────────────────────────────────
# Legacy better-auth logins (Google/GitHub/Microsoft social, magic link, email
# OTP) were removed after OIDC cutover — no legacy auth env vars remain.

# Hosted MCP (Speakeasy Gram) OAuth — better-auth acts as the OAuth provider.
# Leave unset where hosted MCP isn't configured; the trusted client is then inert.
GRAM_OAUTH_CLIENT_ID=        # OAuth client id registered for the Gram MCP server
GRAM_OAUTH_CLIENT_SECRET=    # OAuth client secret for the Gram MCP server
GRAM_OAUTH_REDIRECT_URI=     # Gram callback, e.g. https://<gram-domain>/oauth/<slug>/callback
MCP_OAUTH_LOGIN_PAGE=        # App sign-in page (defaults to ${NEXT_PUBLIC_APP_URL}/auth)
MCP_RESOURCE_URL=            # Optional: the hosted MCP resource identifier (Gram server URL)

DATABASE_URL=

# RLS client roles (optional in dev — falls back to DATABASE_URL when unset).
# Requires the `comp_app`/`comp_service` roles + RLS migration to be applied.
#   DATABASE_URL_TENANT=  # non-superuser app role, subject to RLS policies
#   DATABASE_URL_SERVICE= # BYPASSRLS role for better-auth/system/background
DATABASE_URL_TENANT=
DATABASE_URL_SERVICE=

NOVU_API_KEY=

# Service tokens for internal service-to-service auth (scoped, per-service)
SERVICE_TOKEN_TRIGGER= # Used by background task service calls
SERVICE_TOKEN_PORTAL=  # Used by Portal app

# Redis (direct connection — LocalStack Redis locally, ElastiCache in AWS)
# Defense-in-depth: connect as the least-privilege ACL user `comp_app` (scoped
# to app:* keys). The docker-compose Redis defines comp_app/comp_service ACLs
# in infra/redis/redis.conf. LOCAL_TRIGGER_REDIS_URL is the full-access
# `comp_service` role used by BullMQ/trigger-local queues.
REDIS_URL=redis://comp_app:comp_app_local_dev_password@localhost:6379
LOCAL_TRIGGER_REDIS_URL=redis://comp_service:comp_service_local_dev_password@localhost:6379

GOOGLE_GENERATIVE_AI_API_KEY=

# Browserbase — the cloud browser that powers Browser Automations.
# REQUIRED for the browser-automation feature (connect, analyze, runs).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional model overrides (defaults are sensible; no need to set these).
# BROWSERBASE_CUA_MODEL: screenshot-based navigation agent. Defaults to
#   "google/gemini-3.8-flash" (needs GOOGLE_GENERATIVE_AI_API_KEY).
# BROWSERBASE_STAGEHAND_MODEL: model behind page reading / pass-fail verdicts —
#   keep this a general model (Gemini Flash), NOT a computer-use model.
BROWSERBASE_CUA_MODEL=
BROWSERBASE_STAGEHAND_MODEL=

# 1Password service account token (starts with "ops_") for storing browser-
# automation logins in a Comp-managed vault.
# Enables the "Sign in for me" password path: Comp stores the login and signs in
# on its own (including generating 2FA codes) for the first sign-in and for
# scheduled runs.
# Optional — when unset, that path is unavailable and users sign in manually in
# the live browser each time (no unattended re-login).
# Create one at 1Password → Developer → Service Accounts (needs vault-create access).
OP_SERVICE_ACCOUNT_TOKEN=

# Inference.net Catalyst tracing (optional — no-op if CATALYST_OTLP_TOKEN is unset)
CATALYST_OTLP_TOKEN=

# Email delivery (SQS queue + SES sender, AWS)
EMAIL_SQS_QUEUE_URL= # e.g., https://sqs.<region>.amazonaws.com/<account>/comp-emails
EMAIL_FROM_SYSTEM= # e.g., noreply@mail.gideondefender.com
EMAIL_FROM_DEFAULT= # e.g., hello@mail.gideondefender.com
EMAIL_FROM_MARKETING= # e.g., marketing@mail.gideondefender.com
EMAIL_FROM_TRUST_PORTAL= # e.g., OpenComp <noreply@mail.trust.inc> — sender for Trust Portal access/NDA emails (falls back to EMAIL_FROM_SYSTEM)
EMAIL_TO_TEST= # optional — overrides every recipient for test sends
EMAIL_REPLY_TO_MARKETING= # optional — Reply-To for marketing channel

# Background checks — Checkr native
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
CHECKR_PACKAGE= # e.g., tasker_standard — from Checkr dashboard
CHECKR_API_BASE_URL=https://api.checkr.com
MACED_API_KEY=mc_dev_dummy_api_key

# Phase 0 — Gideon IAM + Agent Communications (read-only shadow)
# HybridAuthGuard order: x-api-key → x-service-token → Gideon JWT (shadow) → cookie (native session)
# Generic OIDC names are primary since 2026-10-15; GIDEON_* login/JWT vars
# below remain as deprecated fallback for one release (warned once at use).
OIDC_ISSUER_URL= # e.g., http://localhost:8081 (auth) or https://auth.gideon.dev — JWKS at /.well-known/jwks.json
GIDEON_IDENTITY_URL= # deprecated alias for OIDC_ISSUER_URL (platform HR/shadow reads keep it directly)
AUTH__IDENTITY_URL= # alias for GIDEON_IDENTITY_URL (agent-comms compat)
OIDC_JWT_ISSUER= # e.g., https://auth.gideon.dev — must match Auth JWT_ISSUER (dev: https://api.dev.gideondefender.com)
OIDC_JWT_AUDIENCE= # must match Auth JWT_AUDIENCE or verify() fails closed (dev verified 2026-09-18: gideon-cockpit; do NOT reuse across envs)
GIDEON_JWT_ISSUER= # deprecated alias for OIDC_JWT_ISSUER
GIDEON_JWT_AUDIENCE= # deprecated alias for OIDC_JWT_AUDIENCE
OIDC_JWT_ENABLED=false # true to enforce OIDC JWT, false = shadow fallback to session. Enforce 401s only OIDC-shaped JWTs (see OidcJwtService.isOidcToken); opaque Bearer tokens fall through to session.
OIDC_JWT_SHADOW_ENABLED= # true to shadow+log OIDC JWT, false to disable, default auto when OIDC_ISSUER_URL set
GIDEON_JWT_ENABLED= # deprecated alias for OIDC_JWT_ENABLED
GIDEON_JWT_SHADOW_ENABLED= # deprecated alias for OIDC_JWT_SHADOW_ENABLED
OIDC_JWKS_CACHE_TTL_SECS=300 # JWKS cache TTL (agent-comms default 300)
GIDEON_JWKS_CACHE_TTL_SECS= # deprecated alias for OIDC_JWKS_CACHE_TTL_SECS
GIDEON_SHADOW_ENABLED=true # log mismatches for GET /v1/platform/tenants/:id/operations (Phase 0)
GIDEON_INTERNAL_SERVICE_TOKEN= # Required for HR sync IdP fallback when a local subject is missing
GIDEON_HR_IDENTITY_URL= # Optional internal Auth base URL for HR lookups; defaults to GIDEON_IDENTITY_URL
GIDEON_AGENT_COMMS_URL= # e.g., http://localhost:8082 — Agent Communications admin API
AGENT_COMMS_URL= # alias for GIDEON_AGENT_COMMS_URL
GIDEON_DEVICES_PROXY_ENABLED=false # true to proxy GET /v1/admin/devices to agent-comms (Phase 0 shadow, else 404)
GIDEON_DEVICE_ASSERTION_HMAC_SECRET= # >=32B shared with Auth DEVICE_ASSERTION_HMAC_SECRET for X-Gideon-Device-Assertion at POST /v1/auth/complete
# Milestone 1 — OIDC login (dual-run). Confidential client registered
# with the auth team per environment; redirect URI must match registration
# exactly (only http://localhost is accepted for non-HTTPS dev redirects).
# NOTE: renaming the registered redirect URI requires an IdP-side app update;
# the API keeps serving the legacy /v1/auth/gideon/* paths as an alias.
OIDC_CLIENT_ID= # e.g., opencomp-local
OIDC_CLIENT_SECRET= # OPTIONAL — only for confidential apps; public (`is_public`) apps have no secret and use PKCE-bound `none` auth. Never commit a real value.
OIDC_REDIRECT_URI= # e.g., http://localhost:3333/v1/auth/oidc/callback — must be registered in the IdP app
GIDEON_OIDC_CLIENT_ID= # deprecated alias for OIDC_CLIENT_ID
GIDEON_OIDC_CLIENT_SECRET= # deprecated alias for OIDC_CLIENT_SECRET
GIDEON_OIDC_REDIRECT_URI= # deprecated alias for OIDC_REDIRECT_URI
# OIDC_SCOPES=openid profile email
# GIDEON_OIDC_SCOPES= # deprecated alias for OIDC_SCOPES
# Claims policy: tenant-claim names and email verification.
# Defaults preserve Gideon behavior. Explicit email_verified=false always
# denies; the opt-out permits an omitted flag only for an already linked subject.
# OIDC_TENANT_CLAIM=tid,tenant_id,organizationId,tenantId
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# We are not using security hub service it is only the variable prefix for matching with old one
SECURITY_HUB_ROLE_ASSUMER_ARN=
SECURITY_HUB_GOVCLOUD_ROLE_ASSUMER_ARN=
SECURITY_HUB_GOVCLOUD_ACCESS_KEY_ID=
SECURITY_HUB_GOVCLOUD_SECRET_ACCESS_KEY=
# Optional: only set when using temporary GovCloud credentials. Leave unset for long-lived IAM user keys.
# SECURITY_HUB_GOVCLOUD_SESSION_TOKEN=
